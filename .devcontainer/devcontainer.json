{
    "name": "Dotfiles (Ubuntu 24.04)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "initializeCommand": ["make", "feature"],
    "features": {
        "./features/devchain": {}
    },
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
