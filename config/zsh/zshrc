# Loaded by the Nix-packaged Zsh; all mutable state stays outside the store.
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/devchain/zsh/history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY INC_APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
mkdir -p "${HISTFILE:h}"

autoload -Uz compinit
_devchain_completion_dir="${XDG_CACHE_HOME:-$HOME/.cache}/devchain/zsh"
mkdir -p "$_devchain_completion_dir"
compinit -d "$_devchain_completion_dir/zcompdump"
unset _devchain_completion_dir

bindkey -v
KEYTIMEOUT=10
bindkey -M viins '^R' history-incremental-search-backward

autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats '%F{magenta}(%b)%f'
_devchain_vcs_info() { vcs_info }
add-zsh-hook precmd _devchain_vcs_info
setopt PROMPT_SUBST
PROMPT='%F{green}%n@%m%f %F{blue}%~%f ${vcs_info_msg_0_}%# '

source @autosuggestions@/share/zsh-autosuggestions/zsh-autosuggestions.zsh
